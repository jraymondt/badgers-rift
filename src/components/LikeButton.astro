---
interface Props {
  postSlug: string;
}

const { postSlug } = Astro.props;
const likeId = `like-${postSlug}`;
---

<div class="like-container">
  <button 
    id={likeId}
    class="like-button"
    title="Like this post"
  >
    ❤️
  </button>
</div>

<script>
  // Find all like buttons on the page
  const buttons = document.querySelectorAll('button.like-button');

  buttons.forEach((btn) => {
    // @ts-ignore
    const button = btn;

    // Handle click - toggle the liked state
    button.addEventListener('click', () => {
      button.classList.toggle('liked');
    });
  });
</script>

<style>
  .like-container {
    display: flex;
    gap: 1em;
    margin: 2em 0;
    padding: 1.5em;
    border: 3px solid var(--cga-pink);
    background-color: rgba(196, 81, 158, 0.05);
  }

  .like-button {
    padding: 0.75em 1.5em;
    border: 3px solid var(--cga-pink);
    background-color: var(--cga-navy);
    color: var(--cga-pink);
    font-family: 'IBM VGA', monospace;
    font-size: 1.5em;
    cursor: pointer;
    transition: all 0.2s ease, transform 0.3s ease;
  }

  .like-button:hover {
    transform: scale(1.1);
  }

  .like-button:active {
    animation: pulse 0.6s ease-out;
  }

  .like-button.liked {
    background-color: var(--cga-pink);
    color: var(--cga-navy);
    animation: heartBeat 0.6s ease-out;
  }

  @keyframes heartBeat {
    0% {
      transform: scale(1);
    }
    25% {
      transform: scale(1.3);
    }
    50% {
      transform: scale(1.1);
    }
    75% {
      transform: scale(1.25);
    }
    100% {
      transform: scale(1);
    }
  }

  @keyframes pulse {
    0% {
      transform: scale(1);
    }
    50% {
      transform: scale(0.95);
    }
    100% {
      transform: scale(1);
    }
  }
</style>

